# Black vehicle defaults; local.env may override these values.
PI_GATEWAY_IP=192.168.1.187
PI_STREAM_BASE_URL=http://127.0.0.1:8086
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=1
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CALIBRATION_AUTO_TRAFFIC=0
CALIBRATION_STATION_CONFIG=config/black_vehicle/station.yaml
CALIBRATION_INITIAL_EXTRINSICS=config/black_vehicle/initial_extrinsics.yaml
CALIBRATION_CAMERA_CONFIG=config/black_vehicle/camera_devices.yaml
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_PIXEL_FORMAT=UYVY
