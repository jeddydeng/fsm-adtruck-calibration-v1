<?xml version="1.0"?>
<robot name="white_calibration_sensors" xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    Standalone wrapper for sensing-only calibration sessions.  The normal
    Autoware description already provides base_link before it expands
    sensors.xacro; this wrapper provides that root without loading planning,
    localization, control, a map, or the vehicle mesh.
  -->
  <xacro:arg name="config_dir" default="$(find white_sensor_kit_description)/config"/>
  <xacro:property name="base_cal" value="${xacro.load_yaml('$(arg config_dir)/sensors_calibration.yaml')}"/>
  <xacro:property name="sensor_cal" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>
  <link name="base_link"/>
  <xacro:include filename="$(find white_sensor_kit_description)/urdf/sensor_tree.xacro"/>
  <xacro:white_sensor_tree base_cal="${base_cal}" sensor_cal="${sensor_cal}"/>
</robot>
