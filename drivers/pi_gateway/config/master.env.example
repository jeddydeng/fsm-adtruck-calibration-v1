# FSM-Pi-Master production defaults for Raspberry Pi fsm-pi-001.
# This is a trusted shell environment file. Values must not contain spaces.
PI_GATEWAY_IP=192.168.1.186
IPC_EXPECTED_IP=192.168.1.102

# Four-fisheye BEV/status transport.
BEV_BIND_IP=0.0.0.0
BEV_DATA_PORT=5610
BEV_CONTROL_PORT=5611
BEV_HELLO_INTERVAL_S=2.0
BEV_REPORT_INTERVAL_S=3600
WEB_BIND_IP=127.0.0.1
WEB_PORT=8086
VEHICLE_IO_PORT=8089

# Traffic-light camera UDP lease and ROS 2 bridge.
TRAFFIC_BIND_IP=0.0.0.0
TRAFFIC_DATA_PORT=5620
TRAFFIC_CONTROL_PORT=5621
TRAFFIC_HEARTBEAT_INTERVAL_S=1.0
TRAFFIC_LEASE_MS=3000
TRAFFIC_WIDTH=320
TRAFFIC_HEIGHT=240
TRAFFIC_HTTP_BIND_IP=127.0.0.1
TRAFFIC_HTTP_PORT=8090
TRAFFIC_IMAGE_TOPIC=/sensing/camera/traffic_light_front/image_raw/compressed
TRAFFIC_CAMERA_INFO_TOPIC=/sensing/camera/traffic_light_front/camera_info
TRAFFIC_FRAME_ID=traffic_light_front/camera_optical_link

# ROS 2 is local to the IPC. It is deliberately not bridged to the Pi.
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=92
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Offline Mandarin TTS. The Web UI can select either model/voice role.
PIPER_MODEL_NAME=zh_CN-huayan-medium.onnx

