[Unit]
Description=FSM-Pi read-only CAN, RS485 display and priority voice service
Requires=fsm-pi-can-interfaces.service
Wants=sound.target
After=fsm-pi-can-interfaces.service sound.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_GROUP@
SupplementaryGroups=audio dialout
WorkingDirectory=@INSTALL_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @INSTALL_DIR@/app/vehicle-io/pi/vehicle_io_daemon.py --config @INSTALL_DIR@/state/vehicle-io.json --asset-dir @INSTALL_DIR@/state/audio-cache --original-asset-dir @INSTALL_DIR@/app/vehicle-io/original-audio --api-bind 0.0.0.0 --ffmpeg /usr/bin/ffmpeg
Restart=always
RestartSec=2
TimeoutStopSec=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@INSTALL_DIR@/app/vehicle-io
ReadWritePaths=@INSTALL_DIR@/state
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryMax=160M
CPUQuota=40%

[Install]
WantedBy=multi-user.target
