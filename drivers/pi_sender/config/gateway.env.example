# FSM-Pi-001 production camera and telemetry gateway configuration.
PEER_IP=192.168.1.102

# Confirmed physical direction mapping on vehicle 186 (2026-08-28).
CAMERA_FRONT=/dev/v4l/by-path/platform-xhci-hcd.1-usb-0:1:1.0-video-index0
CAMERA_REAR=/dev/v4l/by-path/platform-xhci-hcd.0-usb-0:1:1.0-video-index0
CAMERA_LEFT=/dev/v4l/by-path/platform-1000110000.pcie-pci-0001:01:00.0-usb-0:4:1.0-video-index0
CAMERA_RIGHT=/dev/v4l/by-path/platform-1000110000.pcie-pci-0001:01:00.0-usb-0:2:1.0-video-index0

DATA_PORT=5610
CONTROL_PORT=5611
CAPTURE_WIDTH=1600
CAPTURE_HEIGHT=1200
OUTPUT_FPS=10
JPEG_QUALITY=75
BEV_SIZE=512
DEFAULT_OUTPUT_MODE=bev

# Reviewed 2026-09-03 planar calibration converted to physical-centred BEV.
# 512 px * 0.021 m/px = 10.752 m in both axes.
METERS_PER_PIXEL=0.021
VEHICLE_LENGTH_M=4.35
VEHICLE_WIDTH_M=1.53
CALIBRATION_DIR=@INSTALL_DIR@/app/bev/calibration/fisheye_bev_20260903_physical_center

# Both links are brought up in kernel listen-only mode; application code never
# transmits a CAN frame.
CAN_INTERFACE_PRIMARY=can10
CAN_INTERFACE_SECONDARY=can11
CAN_STALE_MS=500
